#!/bin/bash
# Zode command line.  ./zode help
ZODE_HOME="$(cd "$(dirname "$0")" && pwd)"
cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  install)   exec "$ZODE_HOME/scripts/install.sh" "$@" ;;
  update-zcode) exec bash "$ZODE_HOME/scripts/update-zcode.sh" "$@" ;;
  app)       exec bash "$ZODE_HOME/scripts/apply-app.sh" "$@" ;;
  doctor)    exec node "$ZODE_HOME/bridge/doctor.mjs" "$@" ;;
  relay)     exec node "$ZODE_HOME/relay/relay.mjs" serve "$@" ;;
  pair)      exec node "$ZODE_HOME/relay/relay.mjs" pair "$@" ;;
  devices)   exec node "$ZODE_HOME/relay/relay.mjs" devices "$@" ;;
  revoke)    exec node "$ZODE_HOME/relay/relay.mjs" revoke "$@" ;;
  task)      exec node "$ZODE_HOME/bridge/zcode-task.mjs" "$@" ;;
  stop)      exec node "$ZODE_HOME/bridge/zcode-stop.mjs" "$@" ;;
  skill)     exec "$ZODE_HOME/scripts/install-skill.sh" "$@" ;;
  scan)      exec node "$ZODE_HOME/scripts/scan-secrets.mjs" "$@" ;;
  help|-h|--help|*)
    cat <<HELP
Zode: Claude Code decides, ZCode writes, you watch from your phone.

  zode install            build Zode.app from your ZCode, install the skill
  zode update-zcode [--check]   update the original ZCode, then rebuild Zode.app
  zode app [--uninstall]  (re-)apply the phone-relay integration to Zode.app
  zode doctor [worktree]  check that everything is ready (add --models to test the login)
  zode relay              start the phone relay in a terminal (Zode.app runs it too)
  zode pair               print a QR code to pair a phone
  zode devices | revoke <id>   list or remove paired phones
  zode task --worktree W --order file.md   send one work order to ZCode
  zode stop <sessionId>   stop a running ZCode turn
  zode skill              reinstall the Claude Code skill
  zode scan               scan this repo for personal data before you share it
HELP
    ;;
esac
