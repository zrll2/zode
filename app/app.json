{
  "expo": {
    "name": "Zode",
    "slug": "zode",
    "version": "1.0.0",
    "scheme": "zode",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.zode.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSCameraUsageDescription": "Zode scans the pairing QR code shown by the relay on your Mac."
      }
    },
    "android": {
      "package": "dev.zode.app",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1C1B1A"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Zode scans the pairing QR code shown by the relay on your Mac."
        }
      ],
      "expo-secure-store"
    ],
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
