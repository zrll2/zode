{
  "expo": {
    "name": "Zode",
    "slug": "zode",
    "version": "1.1.0",
    "scheme": "zode",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "sg.comex.zode",
      "buildNumber": "4",
      "supportsTablet": false,
      "requireFullScreen": false,
      "entitlements": {
        "keychain-access-groups": ["$(AppIdentifierPrefix)sg.comex.zode.shared"]
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "LSApplicationQueriesSchemes": ["tailscale"],
        "UIBackgroundModes": ["remote-notification"],
        "NSLocalNetworkUsageDescription": "Zode connects to the relay that runs on your Mac, over your local or private network.",
        "NSCameraUsageDescription": "Zode scans the pairing QR code shown by the Mac, and lets you attach photos you take to a message.",
        "NSMicrophoneUsageDescription": "Zode uses the microphone only when you tap the mic, to turn your voice into a message. The audio goes to your own Mac and is not kept.",
        "NSPhotoLibraryUsageDescription": "Zode lets you attach photos from your library to a message for ZCode."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.zode.app",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1C1B1A"
      },
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Zode scans the pairing QR code shown by the Mac, and lets you attach photos you take to a message.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Zode lets you attach photos from your library to a message for ZCode.",
          "cameraPermission": "Zode scans the pairing QR code shown by the Mac, and lets you attach photos you take to a message.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FAF9F5",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1F1E1D"
          }
        }
      ],
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-audio",
      [
        "@bacons/apple-targets",
        {
          "appleTeamId": "XP5Q8LPH52"
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c2be34e6-2350-4e75-b619-55f5d6474b06"
      }
    },
    "owner": "zrll2"
  }
}
